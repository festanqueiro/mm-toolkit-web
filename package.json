{
  "name": "mm-toolkit-web",
  "version": "0.1.24",
  "private": true,
  "description": "MM Toolkit in the browser: promo videos, clip cutting and media conversion, fully client-side.",
  "type": "module",
  "license": "MIT",
  "author": "Francisco Estanqueiro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/festanqueiro/mm-toolkit-web.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:gl": "vitest run --project 'gl*'",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "bench": "playwright test -c playwright.bench.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.1",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "^1.61.0",
    "@mediabunny/flac-encoder": "^1.61.0",
    "@mediabunny/mp3-encoder": "^1.61.0",
    "client-zip": "^2.5.1",
    "fast-png": "^8.0.0",
    "mediabunny": "^1.61.0",
    "onnxruntime-web": "^1.30.0"
  }
}
